@model IEnumerable<Domain.TourN>
@{
	string[] images = { "~/images/tr1.png", "~/images/tr2.png", "~/images/tr7.png" };
	string[] titles = { "Tournament 1", "Tournament 2", "Tournament 3" };
	string[] texts = {
		"LIVE!",
		"LIVE!",
		"LIVE!"
	};
	var tournaments = Model.ToList();
}
@for (int i = 0; i < 3; i++)
{
	<div class="col-sm-12 col-lg-4">
		<div class="icon_1">
			@if (tournaments.Count > i)
			{
				<a asp-area="" asp-controller="TourN" asp-action="Details" asp-route-id="@tournaments[i].Id">
					<img src="@Url.Content(images[i])" />
				</a>
			}
			else
			{
				<img src="@Url.Content(images[i])" />
			}
		</div>
		<h1 class="website_text">@titles[i]</h1>
		<p class="dolor_text">@texts[i]</p>
	</div>
}